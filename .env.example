# =============================================================================
# Copy to .env and fill in. .env is git-ignored and must never be committed.
# config/ holds parameters; .env holds secrets. The two never mix.
# =============================================================================

# --- Neo4j -------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# --- Optional runtime overrides ---------------------------------------------
# Only these four keys can be overridden from the environment. Everything else
# must be a config change, so it shows up in version control.
# APND_SCALE=0.1
# APND_SEED=20260929
# APND_ENVIRONMENT=development
# APND_ALERT_CAPACITY_K=100